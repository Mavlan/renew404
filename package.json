{
  "name": "renew404",
  "private": true,
  "version": "1.2.0",
  "description": "A local-first, offline-ready PWA for tracking subscriptions and renewal dates.",
  "license": "MIT",
  "homepage": "https://renew.try404.com/",
  "keywords": [
    "subscription-tracker",
    "renewal-reminder",
    "local-first",
    "offline-first",
    "pwa",
    "indexeddb",
    "vue"
  ],
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm test && pnpm build",
    "release:1panel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-1panel.ps1"
  },
  "dependencies": {
    "@iconify-icons/logos": "2.0.0",
    "@iconify-icons/simple-icons": "2.0.0",
    "@iconify/vue": "5.0.1",
    "@lobehub/icons-static-svg": "1.94.0",
    "@lucide/vue": "^1.33.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.5",
    "pinia": "^4.0.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "simple-icons": "^16.28.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
